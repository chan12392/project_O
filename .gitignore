node_modules/
dist/
target/
.env
.env.*
*.local
.DS_Store
Thumbs.db

# Hallmark render-tier screenshots (regenerated by sloplint --render); the log stays.
.hallmark/shots/
app/.hallmark/shots/

# Grafly's local graph cache — regenerable, not committed (run `grafly build`).
/.grafly/

# Intermediate aligned bodies; regenerate with scripts/align-sprite-sheets.py (see build-character-parts.py).
app/public/office/parts/body-*.png
__pycache__/

# Tauri build output (schemas regenerated by tauri-build).
app/src-tauri/gen/
# The `o` sidecar copied in by scripts/prepare-sidecar.mjs for the installer build.
app/src-tauri/binaries/

# Agent worktrees (Claude Code isolation) live inside the checkout; never commit them.
.claude/worktrees/
