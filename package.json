{
  "name": "project-o",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test \"tests/*.test.ts\"",
    "check": "tsc --noEmit",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check:dependencies": "python scripts/check-dependencies.py",
    "test:dependencies": "python -m unittest discover -s tests/dependency-security -p test_*.py",
    "guard": "o scan --all",
    "prepare": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "typescript": "^5.9.0"
  }
}
